# Project Caelum-EO Environment Configuration
# Repository: github.com/FranekJemiolo/Caelum-EO

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_STAC_INGEST=geoint-stac-ingest
KAFKA_CLIENT_ID=caelum-stac-poller

# Copernicus Data Space Ecosystem (CDSE) Credentials & STAC Endpoint
CDSE_STAC_API_URL=https://catalogue.dataspace.copernicus.eu/stac
CDSE_USERNAME=your_copernicus_username
CDSE_PASSWORD=your_copernicus_password

# Database (PostGIS)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=caelum_geoint
POSTGRES_USER=caelum_user
POSTGRES_PASSWORD=caelum_secure_password

# Polling Strategy
DEFAULT_CLOUD_COVER_MAX=20.0
POLL_INTERVAL_SECONDS=3600
LOOKBACK_DAYS=7
